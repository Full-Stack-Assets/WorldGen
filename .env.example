# Optional: enables AI-powered world lore via Gemini
# Get a free key at https://aistudio.google.com/apikey
VITE_GEMINI_API_KEY=

# Or paste your key in the app's AI Lore section (saved in browser)

# ── Monetization (all optional; UI hides and no scripts load when unset) ──

# Donation links — must be full https:// URLs
VITE_SUPPORT_KOFI=
VITE_SUPPORT_GITHUB_SPONSORS=
VITE_SUPPORT_PATREON=

# "Get WorldGen Pro" checkout link (e.g. Gumroad or Lemon Squeezy product URL)
VITE_PRO_PRODUCT_URL=

# Google AdSense — both required to render the ad unit
# Also add an ads.txt to public/ with your publisher line (see README)
VITE_ADSENSE_CLIENT=
VITE_ADSENSE_SLOT=
