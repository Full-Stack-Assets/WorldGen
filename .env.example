# Optional: enables AI-powered world lore via Gemini
# Get a free key at https://aistudio.google.com/apikey
VITE_GEMINI_API_KEY=

# Or paste your key in the app's AI Lore section (saved in browser)

# ── Monetization (all optional; UI hides and no scripts load when unset) ──

# Donation links — must be full https:// URLs
VITE_SUPPORT_KOFI=
VITE_SUPPORT_GITHUB_SPONSORS=
VITE_SUPPORT_PATREON=

# ── WorldGen Pro (license-gated tier: ad-free, ultra detail, map exports) ──

# "Get WorldGen Pro" checkout link (e.g. Gumroad or Lemon Squeezy product URL)
VITE_PRO_PRODUCT_URL=

# Gumroad product id — enables the in-app license-key unlock. Verified against
# https://api.gumroad.com/v2/licenses/verify. Without it, only the buy link shows.
VITE_GUMROAD_PRODUCT_ID=

# Google AdSense — both required to render the ad unit (Pro users never see ads)
# Also add an ads.txt to public/ with your publisher line (see README)
VITE_ADSENSE_CLIENT=
VITE_ADSENSE_SLOT=

# Affiliate / recommended-tools panel. Set to "true" to show it, then edit the
# partner links in src/lib/affiliates.ts to your own tagged affiliate URLs.
VITE_AFFILIATE_ENABLED=
